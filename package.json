{
  "name": "video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "用代码做视频：基于 Remotion 的视频制作仓库",
  "scripts": {
    "studio": "remotion studio",
    "render": "node scripts/render.mjs",
    "still": "node scripts/still.mjs",
    "audio": "python3 scripts/make_audio.py",
    "typecheck": "tsc --noEmit",
    "render:vertical": "node scripts/render.mjs TechCyclesVertical",
    "voiceover": "python3 scripts/voiceover.py generate",
    "voiceover:check": "python3 scripts/voiceover.py check",
    "produce": "bash scripts/produce.sh"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@remotion/cli": "4.0.537",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
