# PostgreSQL connection string (Supabase / Neon / local Postgres)
DATABASE_URL="postgresql://app:app@localhost:5432/health_quiz"

# Used by `npm test` (integration tests run against a real Postgres database;
# the test suite TRUNCATEs tables between tests — never point this at production)
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/health_quiz_test"
